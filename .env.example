# OpenAI-compatible endpoint (used for gpt-5.6-luna / gpt-5.6-terra)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Agnes AI (fixed model: agnes-2.5-flash, base URL https://apihub.agnes-ai.com/v1)
AGNES_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Ollama - only needed if it's not running on the default local port
OLLAMA_HOST=http://localhost:11434
